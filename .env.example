# Backend
BACKEND_PORT=3000
PROXY_PORT=3001

# Database
DB_PATH=./data/firewall.db

# Auth — Google Desktop OAuth client (hardcoded in electron/main.js for packaged builds).
# Set here to override in dev, or to rotate credentials without a new build.
# Create via Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Application type: Desktop app. Add http://127.0.0.1 as an authorised redirect URI.
# GOOGLE_CLIENT_ID=<your-desktop-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-desktop-client-secret>
# GITHUB_CLIENT_ID=

# Proxy hardening (v2)
CF_PROXY_TIMEOUT_MS=30000
CF_PROXY_BATCH_LIMIT_KB=256
CF_RATE_LIMIT_PER_MIN=100
